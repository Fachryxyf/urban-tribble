# Urban Tribble — konfigurasi LLM (salin ke .env lalu isi)
# .env TIDAK di-commit. .env.example yang di-commit.

# Endpoint standar OpenAI-compatible
LLM_BASE_URL=https://ai.paas.id
LLM_API_KEY=GANTI_DENGAN_API_KEY_ANDA

# Model fallback (dipakai kalau model per role tidak diisi)
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=6000
LLM_TEMPERATURE=0.8

# Model per role (opsional, timpa LLM_MODEL)
# Hasil dari tabel rombongan murah
LLM_MODEL_CHAT=qwen3.7-flash
LLM_MODEL_KETUA=deepseek-v4-flash
LLM_MODEL_PENGACARA=deepseek-v4-pro
LLM_MODEL_RISIKO=deepseek-v4-flash
LLM_MODEL_FAKTA=deepseek-v4-pro
LLM_MODEL_EKONOM=deepseek-v4-pro
LLM_MODEL_PENULIS=deepseek-v4-pro
